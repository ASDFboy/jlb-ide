{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JLB IDE",
  "version": "0.1.0",
  "identifier": "io.github.asdfboy.jlbide",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JLB IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "interpreters/*": "interpreters/"
    },
    "shortDescription": "An IDE for the .jlb programming language",
    "longDescription": "JLB IDE: write, check and run .jlb programs with the Rust or C interpreter.",
    "copyright": "ASDFboy and Claude",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
